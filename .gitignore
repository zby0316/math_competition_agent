# Local evaluation/test artifacts intentionally excluded from the published system repo
# NOTE: `tests/` is deliberately NOT ignored — the offline regression suite is a
# published quality asset (README §7.1 documents it as such). Only ad-hoc local
# scratch dirs are excluded.
test/
competition/
.codegraph/
.worktrees/
sample_data/
*_output*/
*_outputs*/

# 本地临时/冒烟文件不提交评测仓库
_smoke*
_rerun*
.review_tmp/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# WorkBuddy 系统目录（工作日志/临时文件，非评测交付物）
.workbuddy/
.git_broken/
local_test/

# 浏览器自动化工具临时目录（截图/快照）
.playwright-mcp/

# 本地代码审查产物（不提交评测仓库）
review_results.json
reports/

# 榜单截图等本地个人文件（不提交评测仓库）
ranking-*.png
*.png
*.jpg
*.jpeg

# 参赛资料（官方评测日志/题集/PDF 等调试资料）：官方红线——评测仓库
# 不得包含历史评测日志、测试集或调试用标准答案；全部留在本地不进仓库。
参赛资料/
_extracted/
